# KSP Environment Example
# PostgreSQL
POSTGRES_DB=ksp_intelligence
POSTGRES_USER=ksp_app
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_FIR_TOPIC=fir-events
KAFKA_ALERT_TOPIC=alert-events
KAFKA_AUDIT_TOPIC=audit-events

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=crime-index
ELASTICSEARCH_SCHEMA=http

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=replace-with-256-bit-secret
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_HOURS=24

# ML Service
ML_SERVICE_URL=http://localhost:8001
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-haiku-4-5
LLM_FALLBACK=groq
GROQ_API_KEY=your-groq-api-key-here

# Rate limits
RATE_LIMIT_ANALYST=100
RATE_LIMIT_SUPERVISOR=200
RATE_LIMIT_ADMIN=500
RATE_LIMIT_NL_QUERY=10

# Frontend
FRONTEND_URL=http://localhost:5173
