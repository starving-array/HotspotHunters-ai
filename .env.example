# =============================================================================
# KSP Intelligence Portal — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running:
#   cp .env.example .env
# Never commit the real .env file.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=ksp_intelligence
POSTGRES_USER=ksp_app
POSTGRES_PASSWORD=changeme
POSTGRES_URL=jdbc:postgresql://postgres:5432/ksp_intelligence
POSTGRES_READONLY_USER=ksp_readonly
POSTGRES_READONLY_PASSWORD=changeme

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_FIR_TOPIC=fir-events
KAFKA_ALERT_TOPIC=alert-events
KAFKA_AUDIT_TOPIC=audit-events

# ---- ElasticSearch ----
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=crime-index
ELASTICSEARCH_SCHEMA=http

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- JWT ----
JWT_SECRET=replace-with-256-bit-random-secret
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_HOURS=24

# ---- LLM ----
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-haiku-4-5
LLM_FALLBACK=groq
GROQ_API_KEY=your-groq-api-key-here

# ---- Python ML Service ----
ML_SERVICE_URL=http://python-ml:8001

# ---- Rate Limiting (requests/minute) ----
RATE_LIMIT_ANALYST=100
RATE_LIMIT_SUPERVISOR=200
RATE_LIMIT_ADMIN=500
RATE_LIMIT_NL_QUERY=10

# ---- Spring Boot ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
